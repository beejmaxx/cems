digraph pipeline {
  // Fixed positions keep the three-column reading order and the feedback path
  // legible at the paper's single-column width. `dot` honors this layout key.
  graph [layout=neato, bgcolor="transparent", pad=0.12,
         overlap=true, splines=line, outputorder=edgesfirst];
  node [shape=box, style="filled", color="#333333", pin=true,
        fillcolor="white", fontname="Times-Roman", fontsize=11,
        fontcolor="#171717", margin="0.10,0.08", penwidth=0.7];
  edge [color="#333333", arrowsize=0.65, penwidth=0.7,
        fontname="Times-Roman", fontsize=9, fontcolor="#333333"];

  model [label="Versioned model\nand weights", pos="0,3.6!"];
  ranked [label="Compile\nranked plan", pos="2.35,3.6!"];
  eligible [label="Prepare\neligible plan", pos="4.70,3.6!"];
  emit [label="Native emission\nBounded plan interval", pos="4.70,2.4!"];
  spool [label="Hex spool\nTemporary wordlist", pos="2.35,2.4!"];
  gpu [label="Hashcat", pos="0,2.4!"];
  validate [label="Validate result\nIndependently confirm any hit", pos="0,1.2!"];
  discovery [label="Save private discovery\nSeparate from journal state", pos="2.35,1.2!"];
  prefix [label="Check preceding\nprefix separately", pos="4.70,1.2!"];
  history [label="Accepted coverage\nTarget and checker policy", fillcolor="#f5f5f5", pos="0,0!"];
  journal [label="Commit acknowledgment\nSQLite journal", fillcolor="#f5f5f5", pos="4.70,0!"];
  feedback_a [shape=point, width=0, label="", style=invis, pos="0,-0.62!"];
  feedback_b [shape=point, width=0, label="", style=invis, pos="6.02,-0.62!"];
  feedback_c [shape=point, width=0, label="", style=invis, pos="6.02,3.6!"];

  hit_label [shape=plaintext, style="", margin=0, width=0, height=0, fontsize=9, label="Confirmed hit", pos="1.19,1.57!"];
  negative_label [shape=plaintext, style="", margin=0, width=0, height=0, fontsize=9, label="Completed negative batch", pos="2.38,0.65!"];
  accepted_label [shape=plaintext, style="", margin=0, width=0, height=0, fontsize=9, label="Accepted completion", pos="2.35,0.17!"];

  model -> ranked -> eligible;
  eligible -> emit;
  emit -> spool -> gpu;
  gpu -> validate;
  validate -> discovery;
  discovery -> prefix -> journal;
  validate:s -> journal:w;
  journal -> history;
  history -> feedback_a -> feedback_b -> feedback_c [style=dashed, arrowhead=none];
  feedback_c -> eligible [style=dashed];
}
